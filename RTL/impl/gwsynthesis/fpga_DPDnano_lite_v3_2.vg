output [15:0] dpd_dout_im;
wire n69_3;
wire [15:0] re_sat;
wire [15:0] im_sat;
wire VCC;
wire GND;
  LUT3 re_sat_15_s0 (
    .F(re_sat[15]),
    .I0(clip_dir_re_Z),
    .I1(round_re[15]),
    .I2(clip_re_Z) 
);
