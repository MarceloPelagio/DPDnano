module saturator (
  clk_dpd,
  round_valid,
  core_rst,
  clip_re_Z,
  clip_im_Z,
  clip_dir_re_Z,
  clip_dir_im_Z,
  round_re,
  round_im,
  dpd_overflow,
  dpd_overflow_re,
  dpd_overflow_im,
  dpd_out_valid,
  dpd_dout_re,
  dpd_dout_im
)
;
input clk_dpd;
input round_valid;
input core_rst;
input clip_re_Z;
input clip_im_Z;
input clip_dir_re_Z;
input clip_dir_im_Z;
input [15:0] round_re;
input [15:0] round_im;
